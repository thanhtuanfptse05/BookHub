<?xml version="1.0" encoding="UTF-8"?>
<project name="BookHub" default="default" basedir=".">
    <description>Builds, tests, and runs the project BookHub.</description>
    <import file="nbproject/build-impl.xml"/>

    <!-- Runtime JARs live directly under web/WEB-INF/lib and are copied by -copy-webdir.
         Override generated library-inclusion targets so stale absolute paths in build-impl.xml are bypassed. -->
    <target depends="init" name="library-inclusion-in-archive" unless="dist.ear.dir"/>
    <target depends="init" if="dist.ear.dir" name="library-inclusion-in-manifest"/>

    <!-- Compile and run JUnit 5 tests (tests/unit and tests/integration) without packaging test JARs into WAR. -->
    <target depends="compile" description="Compile JUnit 5 unit and integration tests." name="compile-junit5">
        <mkdir dir="${build.test.classes.dir}"/>
        <javac destdir="${build.test.classes.dir}"
               encoding="${source.encoding}"
               includeantruntime="false"
               source="${javac.source}"
               target="${javac.target}"
               debug="true">
            <src path="tests/unit"/>
            <src path="tests/integration"/>
            <classpath>
                <path path="${build.classes.dir}"/>
                <path path="${javac.test.classpath}"/>
                <path path="${j2ee.platform.classpath}"/>
            </classpath>
            <compilerarg line="${javac.compilerargs}"/>
        </javac>
    </target>

    <target depends="compile-junit5" description="Run JUnit 5 tests via ConsoleLauncher." name="test-junit5">
        <mkdir dir="${build.test.results.dir}"/>
        <java classname="org.junit.platform.console.ConsoleLauncher"
              fork="true"
              failonerror="true"
              dir="${basedir}">
            <classpath>
                <path path="${build.test.classes.dir}"/>
                <path path="${build.classes.dir}"/>
                <path path="${javac.test.classpath}"/>
                <path path="${j2ee.platform.classpath}"/>
            </classpath>
            <arg value="execute"/>
            <arg value="--scan-classpath"/>
            <arg value="${build.test.classes.dir}"/>
            <arg value="--fail-if-no-tests"/>
            <arg value="--details=tree"/>
            <arg value="--reports-dir=${build.test.results.dir}"/>
        </java>
    </target>
</project>
